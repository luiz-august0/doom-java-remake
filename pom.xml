<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.doomjava</groupId>
  <artifactId>doom-java-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>doom-java</name>
  <description>A remake of DOOM (1993) in Java 25 with a vanilla-exact simulation and modern presentation.</description>

  <licenses>
    <license>
      <name>GNU General Public License, version 2</name>
      <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
    </license>
  </licenses>

  <modules>
    <module>doom-math</module>
    <module>doom-wad</module>
    <module>doom-codegen</module>
    <module>doom-lint</module>
    <module>doom-game</module>
    <module>doom-platform-api</module>
    <module>doom-render</module>
    <module>doom-sound</module>
    <module>doom-ui</module>
    <module>doom-engine</module>
    <module>doom-platform-lwjgl</module>
    <module>doom-platform-javasound</module>
    <module>doom-app</module>
    <module>doom-testkit</module>
    <module>doom-tools</module>
    <module>doom-it</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Runtime dependency (ADR-003 / ADR-021) -->
    <lwjgl.version>3.4.3</lwjgl.version>
    <!-- Overridden by the OS/arch profiles below -->
    <lwjgl.natives>natives-macos-arm64</lwjgl.natives>

    <!-- Test dependencies (ADR-015) -->
    <junit.version>5.14.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <jmh.version>1.37</jmh.version>

    <!-- Plugins -->
    <compiler-plugin.version>3.16.0</compiler-plugin.version>
    <surefire-plugin.version>3.6.0</surefire-plugin.version>
    <failsafe-plugin.version>3.6.0</failsafe-plugin.version>
    <enforcer-plugin.version>3.6.3</enforcer-plugin.version>
    <jar-plugin.version>3.5.1</jar-plugin.version>
    <resources-plugin.version>3.5.0</resources-plugin.version>
    <dependency-plugin.version>3.11.0</dependency-plugin.version>
    <jlink-plugin.version>3.3.0</jlink-plugin.version>
    <shade-plugin.version>3.6.0</shade-plugin.version>
    <exec-plugin.version>3.6.4</exec-plugin.version>
    <wrapper-plugin.version>3.3.4</wrapper-plugin.version>
    <clean-plugin.version>3.5.0</clean-plugin.version>
    <install-plugin.version>3.1.4</install-plugin.version>
    <deploy-plugin.version>3.1.4</deploy-plugin.version>
    <site-plugin.version>3.21.0</site-plugin.version>

    <!-- Distribution (profile "dist" of doom-app). jpackage wants a numeric version whose first number is above zero on
         macOS, so it is separate from the Maven version; the release workflow overrides it from the tag. -->
    <dist.app.name>DoomJava</dist.app.name>
    <dist.app.version>1.0.0</dist.app.version>
    <dist.app.vendor>doom-java</dist.app.vendor>
    <!-- Overridden per OS below. app-image works everywhere; dmg (macOS), exe/msi (Windows, needs WiX), deb/rpm (Linux). -->
    <dist.jpackage.type>app-image</dist.jpackage.type>
    <!-- jpackage options of one OS (doom-app/src/dist/jpackage/*.args, paths relative to doom-app). -->
    <dist.jpackage.argfile>${project.basedir}/src/dist/jpackage/app-image.args</dist.jpackage.argfile>
    <!-- false (Windows) also builds an app-image (DoomJava.exe) for the portable zip. -->
    <dist.jpackage.appimage.skip>true</dist.jpackage.appimage.skip>
    <dist.jpackage.exe>${java.home}/bin/jpackage</dist.jpackage.exe>
    <!-- true skips the portable zips of the dist profile (doom-app/src/dist/make-portable.sh). -->
    <dist.portable.skip>false</dist.portable.skip>
    <!-- macOS only: GLFW needs the Cocoa main thread. Harmless system property elsewhere. -->
    <dist.jvm.first.thread>-Ddoom.dist=true</dist.jvm.first.thread>

    <!-- JVM options for forked test JVMs -->
    <test.jvm.args>-Xmx1g -XX:+UseParallelGC -Dfile.encoding=UTF-8</test.jvm.args>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Internal modules -->
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-math</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-wad</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-game</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-platform-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-render</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-sound</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-ui</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-engine</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-platform-lwjgl</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-platform-javasound</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-app</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-testkit</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-tools</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-codegen</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>dev.doomjava</groupId><artifactId>doom-lint</artifactId><version>${project.version}</version></dependency>

      <!-- LWJGL: the only runtime dependency (ADR-003) -->
      <dependency>
        <groupId>org.lwjgl</groupId>
        <artifactId>lwjgl-bom</artifactId>
        <version>${lwjgl.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Tests (ADR-015) -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-core</artifactId>
        <version>${jmh.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-generator-annprocess</artifactId>
        <version>${jmh.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Every module gets JUnit 5 + AssertJ for tests -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <arg>-Xlint:all,-serial,-processing,-missing-explicit-ctor,-requires-automatic,-requires-transitive-automatic</arg>
            </compilerArgs>
            <showWarnings>true</showWarnings>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire-plugin.version}</version>
          <configuration>
            <argLine>${test.jvm.args}</argLine>
            <trimStackTrace>false</trimStackTrace>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe-plugin.version}</version>
          <configuration>
            <argLine>${test.jvm.args}</argLine>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jlink-plugin</artifactId>
          <version>${jlink-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-wrapper-plugin</artifactId>
          <version>${wrapper-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${site-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <!-- ADR-021: only the approved dependencies (and their test-scope transitives) are allowed -->
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>dev.doomjava</include>
                    <include>org.lwjgl</include>
                    <include>org.junit.jupiter:*:*:*:test</include>
                    <include>org.junit.platform:*:*:*:test</include>
                    <include>org.opentest4j:*:*:*:test</include>
                    <include>org.apiguardian:*:*:*:test</include>
                    <include>org.assertj:*:*:*:test</include>
                    <include>net.bytebuddy:*:*:*:test</include>
                    <include>org.openjdk.jmh</include>
                    <include>net.sf.jopt-simple</include>
                    <include>org.apache.commons:commons-math3</include>
                  </includes>
                </bannedDependencies>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- LWJGL natives per OS/arch (the format documented by LWJGL for Maven) -->
    <profile>
      <id>lwjgl-natives-macos-aarch64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties>
        <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
        <dist.jpackage.type>dmg</dist.jpackage.type>
        <dist.jvm.first.thread>-XstartOnFirstThread</dist.jvm.first.thread>
        <dist.jpackage.argfile>${project.basedir}/src/dist/jpackage/macos.args</dist.jpackage.argfile>
      </properties>
    </profile>
    <profile>
      <id>lwjgl-natives-macos-amd64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties>
        <lwjgl.natives>natives-macos</lwjgl.natives>
        <dist.jpackage.type>dmg</dist.jpackage.type>
        <dist.jvm.first.thread>-XstartOnFirstThread</dist.jvm.first.thread>
        <dist.jpackage.argfile>${project.basedir}/src/dist/jpackage/macos.args</dist.jpackage.argfile>
      </properties>
    </profile>
    <profile>
      <id>lwjgl-natives-windows-amd64</id>
      <activation><os><family>windows</family><arch>amd64</arch></os></activation>
      <properties>
        <lwjgl.natives>natives-windows</lwjgl.natives>
        <dist.jpackage.type>exe</dist.jpackage.type>
        <dist.jpackage.exe>${java.home}/bin/jpackage.exe</dist.jpackage.exe>
        <dist.jpackage.argfile>${project.basedir}/src/dist/jpackage/windows.args</dist.jpackage.argfile>
        <dist.jpackage.appimage.skip>false</dist.jpackage.appimage.skip>
      </properties>
    </profile>
    <profile>
      <id>lwjgl-natives-windows-aarch64</id>
      <activation><os><family>windows</family><arch>aarch64</arch></os></activation>
      <properties>
        <lwjgl.natives>natives-windows-arm64</lwjgl.natives>
        <dist.jpackage.type>exe</dist.jpackage.type>
        <dist.jpackage.exe>${java.home}/bin/jpackage.exe</dist.jpackage.exe>
        <dist.jpackage.argfile>${project.basedir}/src/dist/jpackage/windows.args</dist.jpackage.argfile>
        <dist.jpackage.appimage.skip>false</dist.jpackage.appimage.skip>
      </properties>
    </profile>
    <profile>
      <id>lwjgl-natives-linux-amd64</id>
      <activation><os><family>unix</family><name>linux</name><arch>amd64</arch></os></activation>
      <properties><lwjgl.natives>natives-linux</lwjgl.natives></properties>
    </profile>
    <profile>
      <id>lwjgl-natives-linux-aarch64</id>
      <activation><os><family>unix</family><name>linux</name><arch>aarch64</arch></os></activation>
      <properties><lwjgl.natives>natives-linux-arm64</lwjgl.natives></properties>
    </profile>

    <!-- Optional JMH benchmarks (ADR-015): ./mvnw -Pbench verify -->
    <profile>
      <id>bench</id>
      <modules>
        <module>doom-bench</module>
      </modules>
    </profile>
  </profiles>
</project>
