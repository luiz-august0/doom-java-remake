<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.doomjava</groupId>
    <artifactId>doom-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>doom-game</artifactId>
  <name>doom-game</name>
  <description>The vanilla-exact simulation. Exports only doom.game.api and doom.game.view.</description>

  <dependencies>
    <dependency>
      <groupId>dev.doomjava</groupId>
      <artifactId>doom-math</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.doomjava</groupId>
      <artifactId>doom-wad</artifactId>
    </dependency>
    <!-- Build-time only: orders doom-lint before doom-game in the reactor (the processor itself comes from
         annotationProcessorPaths below); nothing from it reaches the runtime. -->
    <dependency>
      <groupId>dev.doomjava</groupId>
      <artifactId>doom-lint</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- BamLint (ADR-006) in warn mode: signed comparisons / >> / division on @Bam values are reported as warnings.
           Switch to -Adoom.lint.mode=error once the warnings are triaged. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>dev.doomjava</groupId>
              <artifactId>doom-lint</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
          <annotationProcessors>
            <annotationProcessor>doom.lint.BamLintProcessor</annotationProcessor>
          </annotationProcessors>
          <compilerArgs combine.children="append">
            <arg>-Adoom.lint.mode=warn</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
