+// Oracle: dumps every replaced string, sorted by the original text.
+static int CompareSubstitutions(const void *a, const void *b)
+{
+    const deh_substitution_t *x = *(const deh_substitution_t *const *) a;
+    const deh_substitution_t *y = *(const deh_substitution_t *const *) b;
+
+    return strcmp(x->from_text, y->from_text);
+}
+
+static void DumpQuoted(FILE *f, const char *s)
+{
+    const unsigned char *p = (const unsigned char *) s;
+
+    fputc('"', f);
+    for (; *p != '\0'; ++p)
+    {
+        if (*p == '\\') fputs("\\\\", f);
+        else if (*p == '"') fputs("\\\"", f);
+        else if (*p == '\n') fputs("\\n", f);
+        else if (*p < 0x20 || *p >= 0x7f) fprintf(f, "\\x%02x", *p);
+        else fputc(*p, f);
+    }
+    fputc('"', f);
+}
+
+void DEH_DumpStrings(FILE *f)
+{
+    deh_substitution_t **list;
+    int i, n = 0;
+
+    if (hash_table_length < 0)
+    {
+        fprintf(f, "strings 0\n");
+        return;
+    }
+    list = malloc(sizeof(*list) * (hash_table_entries + 1));
+    for (i = 0; i < hash_table_length; ++i)
+    {
+        if (hash_table[i] != NULL)
+        {
+            list[n++] = hash_table[i];
+        }
+    }
+    qsort(list, n, sizeof(*list), CompareSubstitutions);
+    fprintf(f, "strings %d\n", n);
+    for (i = 0; i < n; ++i)
+    {
+        fputs("string ", f);
+        DumpQuoted(f, list[i]->from_text);
+        fputs(" -> ", f);
+        DumpQuoted(f, list[i]->to_text);
+        fputc('\n', f);
+    }
+    free(list);
+}
