+    fprintf(f, "god_mode_health %d\n", deh_god_mode_health);
+    fprintf(f, "idfa_armor %d\n", deh_idfa_armor);
+    fprintf(f, "idfa_armor_class %d\n", deh_idfa_armor_class);
+    fprintf(f, "idkfa_armor %d\n", deh_idkfa_armor);
+    fprintf(f, "idkfa_armor_class %d\n", deh_idkfa_armor_class);
+    fprintf(f, "bfg_cells_per_shot %d\n", deh_bfg_cells_per_shot);
+    fprintf(f, "species_infighting %d\n", deh_species_infighting);
+
+    fprintf(f, "cheats %d\n", (int) (sizeof(cheats) / sizeof(cheats[0])));
+    for (i = 0; i < (int) (sizeof(cheats) / sizeof(cheats[0])); ++i)
+    {
+        PrintCheat(f, cheats[i].name, cheats[i].seq);
+    }
+
+    DEH_DumpStrings(f);
+    fputs("end\n", f);
+    fclose(f);
+}
diff --git a/src/doom/oracle_frame.c b/src/doom/oracle_frame.c
new file mode 100644
index 0000000..2dbabc2
--- /dev/null
+++ b/src/doom/oracle_frame.c
@@ -0,0 +1,205 @@
+//
+// Test-oracle extensions for the doom-java project: frame + scene sidecar dump (-dumpframe).
+// See tools/oracle/FORMAT.md.
+//
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+#include "doomtype.h"
+#include "doomstat.h"
+#include "doomdef.h"
+#include "d_player.h"
+#include "i_system.h"
+#include "i_video.h"
+#include "info.h"
+#include "m_argv.h"
+#include "m_menu.h"
+#include "m_misc.h"
+#include "p_local.h"
+#include "p_mobj.h"
+#include "p_pspr.h"
+#include "r_data.h"
+#include "r_defs.h"
+#include "r_main.h"
+#include "r_sky.h"
+#include "r_state.h"
+
+#include "oracle.h"
+
+extern int fuzzpos;
+extern boolean automapactive;
+extern int numtextures;
+
+static int *dump_tics = NULL;
+static int dump_count = 0;
+static int dump_next = 0;
+static char dump_dir[1024];
+static int fuzzpos_at_start = 0;
+
+void Oracle_DumpFrameInit(const char *list, const char *dir)
+{
+    char *copy = strdup(list);
+    char *tok;
+    int i, j;
+
+    M_StringCopy(dump_dir, dir, sizeof(dump_dir));
+    for (tok = strtok(copy, ","); tok != NULL; tok = strtok(NULL, ","))
+    {
+        dump_tics = realloc(dump_tics, (dump_count + 1) * sizeof(int));
+        dump_tics[dump_count++] = atoi(tok);
+    }
+    free(copy);
+    // sort ascending
+    for (i = 0; i < dump_count; ++i)
+    {
+        for (j = i + 1; j < dump_count; ++j)
+        {
+            if (dump_tics[j] < dump_tics[i])
+            {
+                int t = dump_tics[i];
+                dump_tics[i] = dump_tics[j];
+                dump_tics[j] = t;
+            }
+        }
+    }
+    M_MakeDirectory(dump_dir);
+}
+
+void Oracle_BeforeDisplay(void)
+{
+    fuzzpos_at_start = fuzzpos;
+}
+
+static void PrintSprite(FILE *f, const char *tag, const pspdef_t *ps)
+{
+    if (ps->state == NULL)
+    {
+        fprintf(f, "psprite %s -1 -1 %d %d\n", tag, ps->sx, ps->sy);
+    }
+    else
+    {
+        fprintf(f, "psprite %s %d %d %d %d\n", tag, (int) ps->state->sprite,
+                ps->state->frame, ps->sx, ps->sy);
+    }
+}
+
+static void WriteScene(FILE *f, int real_tic, int requested, const char *rawname)
+{
+    player_t *vp = &players[displayplayer];
+    int i;
+
+    Oracle_WriteHeader(f, "doom-scene v1");
+    fprintf(f, "tic %d requested %d gametic %d gamestate %d automap %d leveltime %d\n",
+            real_tic, requested, gametic, (int) gamestate, automapactive ? 1 : 0, leveltime);
+    fprintf(f, "raw %s %d %d\n", rawname, SCREENWIDTH, SCREENHEIGHT);
+    fprintf(f, "view %d %d %d %d %d %d %d %d\n", viewx, viewy, viewz, (int32_t) viewangle,
+            extralight, vp->fixedcolormap, displayplayer, consoleplayer);
+    fprintf(f, "window %d %d %d %d %d %d %d\n", viewwindowx, viewwindowy, scaledviewwidth,
+            viewheight, detailshift, screenblocks, usegamma);
+    fprintf(f, "palette %d\n", ST_GetPaletteIndex());
+    fprintf(f, "fuzzpos %d\n", fuzzpos_at_start);
+    fprintf(f, "sky %d %d\n", skytexture, skyflatnum);
+    fprintf(f, "powers");
+    for (i = 0; i < NUMPOWERS; ++i)
+    {
+        fprintf(f, " %d", vp->powers[i]);
+    }
+    fputc('\n', f);
+    PrintSprite(f, "weapon", &vp->psprites[ps_weapon]);
+    PrintSprite(f, "flash", &vp->psprites[ps_flash]);
+
+    fprintf(f, "texturetranslation %d", numtextures);
+    for (i = 0; i < numtextures; ++i)
+    {
+        fprintf(f, " %d", texturetranslation[i]);
+    }
+    fputc('\n', f);
+    fprintf(f, "flattranslation %d", numflats);
+    for (i = 0; i < numflats; ++i)
+    {
+        fprintf(f, " %d", flattranslation[i]);
+    }
+    fputc('\n', f);
+
+    fprintf(f, "sectors %d\n", numsectors);
+    for (i = 0; i < numsectors; ++i)
+    {
+        sector_t *s = &sectors[i];
+        fprintf(f, "S %d %d %d %d %d %d\n", i, s->floorheight, s->ceilingheight, s->floorpic,
+                s->ceilingpic, s->lightlevel);
+    }
+    fprintf(f, "sides %d\n", numsides);
+    for (i = 0; i < numsides; ++i)
+    {
+        side_t *sd = &sides[i];
+        fprintf(f, "D %d %d %d %d %d %d\n", i, sd->textureoffset, sd->rowoffset,
+                sd->toptexture, sd->bottomtexture, sd->midtexture);
+    }
+
+    {
+        int count = 0;
+        for (i = 0; i < numsectors; ++i)
+        {
+            mobj_t *mo;
+            for (mo = sectors[i].thinglist; mo != NULL; mo = mo->snext)
+            {
+                ++count;
+            }
+        }
+        fprintf(f, "things %d\n", count);
+        for (i = 0; i < numsectors; ++i)
+        {
+            mobj_t *mo;
+            for (mo = sectors[i].thinglist; mo != NULL; mo = mo->snext)
+            {
+                fprintf(f, "T %d %d %d %d %d %d %d %d %d\n", i, mo->x, mo->y, mo->z,
+                        (int32_t) mo->angle, (int) mo->sprite, mo->frame, mo->flags,
+                        mo->player == NULL ? -1 : (int) (mo->player - players));
+            }
+        }
+    }
+    fprintf(f, "end\n");
+}
+
+// Called after every D_Display() that is not part of a wipe. Writes the frame when the
+// last completed tic reached the next requested tic.
+void Oracle_AfterDisplay(void)
+{
+    char path[1100];
+    char rawname[64];
+    FILE *f;
+    int requested;
+
+    if (dump_next >= dump_count || oracle_last_tic < dump_tics[dump_next])
+    {
+        return;
+    }
+    requested = dump_tics[dump_next];
+    // One frame satisfies every requested tic up to the real one.
+    while (dump_next < dump_count && dump_tics[dump_next] <= oracle_last_tic)
+    {
+        ++dump_next;
+    }
+
+    snprintf(rawname, sizeof(rawname), "frame-%06d.raw", oracle_last_tic);
+    snprintf(path, sizeof(path), "%s/%s", dump_dir, rawname);
+    f = fopen(path, "wb");
+    if (f == NULL)
+    {
+        I_Error("oracle: cannot write %s", path);
+    }
+    fwrite(I_VideoBuffer, 1, SCREENWIDTH * SCREENHEIGHT, f);
+    fclose(f);
+
+    snprintf(path, sizeof(path), "%s/frame-%06d.scene", dump_dir, oracle_last_tic);
+    f = fopen(path, "w");
+    if (f == NULL)
+    {
+        I_Error("oracle: cannot write %s", path);
+    }
+    WriteScene(f, oracle_last_tic, requested, rawname);
+    fclose(f);
+}
