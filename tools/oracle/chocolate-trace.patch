+// ---------------------------------------------------------------------------
+// Thinker index (pointer -> position among the live thinkers)
+// ---------------------------------------------------------------------------
+
+static void **map_keys = NULL;
+static int *map_values = NULL;
+static unsigned int map_size = 0; // power of two
+
+static thinker_t **thinker_list = NULL; // index -> thinker
+static int thinker_list_size = 0;
+static int thinker_count = 0;
+
+static unsigned int PtrHash(const void *p)
+{
+    uint64_t v = (uint64_t) (uintptr_t) p;
+
+    v ^= v >> 33;
+    v *= 0xff51afd7ed558ccdULL;
+    v ^= v >> 33;
+    return (unsigned int) v;
+}
+
+// A thinker marked for removal (function == -1) is no longer live.
+static boolean IsLive(const thinker_t *th)
+{
+    return th->function.acv != (actionf_v) (intptr_t) -1;
+}
+
+static void MapClear(unsigned int wanted)
+{
+    unsigned int size = 1024;
+
+    while (size < wanted * 2)
+    {
+        size <<= 1;
+    }
+    if (size != map_size)
+    {
+        free(map_keys);
+        free(map_values);
+        map_keys = calloc(size, sizeof(void *));
+        map_values = calloc(size, sizeof(int));
+        map_size = size;
+    }
+    else
+    {
+        memset(map_keys, 0, size * sizeof(void *));
+    }
+}
+
+static void MapPut(void *key, int value)
+{
+    unsigned int i = PtrHash(key) & (map_size - 1);
+
+    while (map_keys[i] != NULL)
+    {
+        i = (i + 1) & (map_size - 1);
+    }
+    map_keys[i] = key;
+    map_values[i] = value;
+}
+
+// -1 for NULL, -2 for a pointer that is not a live thinker (never dereferenced).
+static int ThinkerIndex(const void *p)
+{
+    unsigned int i;
+
+    if (p == NULL)
+    {
+        return -1;
+    }
+    i = PtrHash(p) & (map_size - 1);
+    while (map_keys[i] != NULL)
+    {
+        if (map_keys[i] == p)
+        {
+            return map_values[i];
+        }
+        i = (i + 1) & (map_size - 1);
+    }
+    return -2;
+}
+
+static void BuildThinkerIndex(void)
+{
+    thinker_t *th;
+    int n = 0;
+
+    for (th = thinkercap.next; th && th != &thinkercap; th = th->next)
+    {
+        if (IsLive(th))
+        {
+            ++n;
+        }
+    }
+    MapClear((unsigned int) n);
+    if (n > thinker_list_size)
+    {
+        thinker_list_size = n + n / 2 + 64;
+        thinker_list = realloc(thinker_list, thinker_list_size * sizeof(*thinker_list));
+    }
+    thinker_count = 0;
+    for (th = thinkercap.next; th && th != &thinkercap; th = th->next)
+    {
+        if (IsLive(th))
+        {
+            MapPut(th, thinker_count);
+            thinker_list[thinker_count++] = th;
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// FNV-1a 64 over little-endian int32 values
+// ---------------------------------------------------------------------------
+
+#define FNV_BASIS 0xcbf29ce484222325ULL
+#define FNV_PRIME 0x100000001b3ULL
+
+static void Fnv(uint64_t *h, int32_t value)
+{
+    uint32_t v = (uint32_t) value;
+    int i;
+
+    for (i = 0; i < 4; ++i)
+    {
+        *h ^= (uint64_t) (v & 0xff);
+        *h *= FNV_PRIME;
+        v >>= 8;
+    }
+}
+
+static int SectorIndex(const sector_t *s)
+{
+    return s == NULL ? -1 : (int) (s - sectors);
+}
+
+static int StateIndex(const state_t *s)
+{
+    return s == NULL ? -1 : (int) (s - states);
+}
+
+// ---------------------------------------------------------------------------
+// Object field extraction (shared by hashing and the verbose trace)
+// ---------------------------------------------------------------------------
+
+#define MOBJ_FIELDS 26
+#define SPECIAL_MAX 16
+
+static void MobjFields(const mobj_t *mo, int32_t *f)
+{
+    int n = 0;
+
+    f[n++] = mo->type;
+    f[n++] = mo->x;
+    f[n++] = mo->y;
+    f[n++] = mo->z;
+    f[n++] = (int32_t) mo->angle;
+    f[n++] = mo->momx;
+    f[n++] = mo->momy;
+    f[n++] = mo->momz;
+    f[n++] = mo->floorz;
+    f[n++] = mo->ceilingz;
+    f[n++] = mo->radius;
+    f[n++] = mo->height;
+    f[n++] = StateIndex(mo->state);
+    f[n++] = mo->tics;
+    f[n++] = mo->sprite;
+    f[n++] = mo->frame;
+    f[n++] = mo->flags;
+    f[n++] = mo->health;
+    f[n++] = mo->movedir;
+    f[n++] = mo->movecount;
+    f[n++] = mo->reactiontime;
+    f[n++] = mo->threshold;
+    f[n++] = mo->lastlook;
+    f[n++] = ThinkerIndex(mo->target);
+    f[n++] = ThinkerIndex(mo->tracer);
+    f[n++] = mo->player == NULL ? -1 : (int) (mo->player - players);
+}
+
+// Fills f with the kind code followed by the fields; returns the number of values.
+static int SpecialFields(thinker_t *th, int32_t *f)
+{
+    int n = 0;
+    actionf_p1 fn = th->function.acp1;
+    int code = 0;
+    int i;
+
+    if (th->function.acv == NULL)
+    {
+        for (i = 0; i < MAXCEILINGS; ++i)
+        {
+            if (activeceilings[i] == (ceiling_t *) th)
+            {
+                code = 102;
+                break;
+            }
+        }
+        if (code == 0)
+        {
+            for (i = 0; i < MAXPLATS; ++i)
+            {
+                if (activeplats[i] == (plat_t *) th)
+                {
+                    code = 104;
+                    break;
+                }
+            }
+        }
+    }
+    else if (fn == (actionf_p1) T_VerticalDoor) code = 1;
+    else if (fn == (actionf_p1) T_MoveCeiling) code = 2;
+    else if (fn == (actionf_p1) T_MoveFloor) code = 3;
+    else if (fn == (actionf_p1) T_PlatRaise) code = 4;
+    else if (fn == (actionf_p1) T_LightFlash) code = 5;
+    else if (fn == (actionf_p1) T_StrobeFlash) code = 6;
+    else if (fn == (actionf_p1) T_Glow) code = 7;
+    else if (fn == (actionf_p1) T_FireFlicker) code = 8;
+
+    f[n++] = code;
+    switch (code)
+    {
+        case 1:
+        {
+            vldoor_t *d = (vldoor_t *) th;
+            f[n++] = d->type;
+            f[n++] = SectorIndex(d->sector);
+            f[n++] = d->topheight;
+            f[n++] = d->speed;
+            f[n++] = d->direction;
+            f[n++] = d->topwait;
+            f[n++] = d->topcountdown;
+            break;
+        }
+        case 2:
+        case 102:
+        {
+            ceiling_t *c = (ceiling_t *) th;
+            f[n++] = c->type;
+            f[n++] = SectorIndex(c->sector);
+            f[n++] = c->bottomheight;
+            f[n++] = c->topheight;
+            f[n++] = c->speed;
+            f[n++] = c->crush ? 1 : 0;
+            f[n++] = c->direction;
+            f[n++] = c->tag;
+            f[n++] = c->olddirection;
+            break;
+        }
+        case 3:
+        {
+            floormove_t *m = (floormove_t *) th;
+            f[n++] = m->type;
+            f[n++] = m->crush ? 1 : 0;
+            f[n++] = SectorIndex(m->sector);
+            f[n++] = m->direction;
+            f[n++] = m->newspecial;
+            f[n++] = m->texture;
+            f[n++] = m->floordestheight;
+            f[n++] = m->speed;
+            break;
+        }
+        case 4:
+        case 104:
+        {
+            plat_t *p = (plat_t *) th;
+            f[n++] = p->type;
+            f[n++] = SectorIndex(p->sector);
+            f[n++] = p->speed;
+            f[n++] = p->low;
+            f[n++] = p->high;
+            f[n++] = p->wait;
+            f[n++] = p->count;
+            f[n++] = p->status;
+            f[n++] = p->oldstatus;
+            f[n++] = p->crush ? 1 : 0;
+            f[n++] = p->tag;
+            break;
+        }
+        case 5:
+        {
+            lightflash_t *l = (lightflash_t *) th;
+            f[n++] = SectorIndex(l->sector);
+            f[n++] = l->count;
+            f[n++] = l->maxlight;
+            f[n++] = l->minlight;
+            f[n++] = l->maxtime;
+            f[n++] = l->mintime;
+            break;
+        }
+        case 6:
+        {
+            strobe_t *s = (strobe_t *) th;
+            f[n++] = SectorIndex(s->sector);
+            f[n++] = s->count;
+            f[n++] = s->minlight;
+            f[n++] = s->maxlight;
+            f[n++] = s->darktime;
+            f[n++] = s->brighttime;
+            break;
+        }
+        case 7:
+        {
+            glow_t *g = (glow_t *) th;
+            f[n++] = SectorIndex(g->sector);
+            f[n++] = g->minlight;
+            f[n++] = g->maxlight;
+            f[n++] = g->direction;
+            break;
+        }
+        case 8:
+        {
+            fireflicker_t *x = (fireflicker_t *) th;
+            f[n++] = SectorIndex(x->sector);
+            f[n++] = x->count;
+            f[n++] = x->maxlight;
+            f[n++] = x->minlight;
+            break;
+        }
+        default:
+            break;
+    }
+    return n;
+}
+
+// ---------------------------------------------------------------------------
+// Trace line
+// ---------------------------------------------------------------------------
+
+#define PLAYER_FIELDS 61
+
+static void PrintPlayer(FILE *out, int pn)
+{
+    player_t *p = &players[pn];
+    mobj_t *mo = p->mo;
+    int32_t v[PLAYER_FIELDS];
+    int n = 0;
+    int i, mask;
+
+    memset(v, 0, sizeof(v));
+    if (mo != NULL)
+    {
+        v[0] = mo->x;
+        v[1] = mo->y;
+        v[2] = mo->z;
+        v[3] = (int32_t) mo->angle;
+        v[4] = mo->momx;
+        v[5] = mo->momy;
+        v[6] = mo->momz;
+        v[7] = mo->health;
+    }
+    n = 8;
+    v[n++] = p->viewz;
+    v[n++] = p->viewheight;
+    v[n++] = p->deltaviewheight;
+    v[n++] = p->bob;
+    v[n++] = p->playerstate;
+    v[n++] = p->health;
+    v[n++] = p->armorpoints;
+    v[n++] = p->armortype;
+    v[n++] = p->readyweapon;
+    v[n++] = p->pendingweapon;
+    mask = 0;
+    for (i = 0; i < NUMWEAPONS; ++i)
+    {
+        if (p->weaponowned[i])
+        {
+            mask |= 1 << i;
+        }
+    }
+    v[n++] = mask;
+    for (i = 0; i < NUMAMMO; ++i) v[n++] = p->ammo[i];
+    for (i = 0; i < NUMAMMO; ++i) v[n++] = p->maxammo[i];
+    mask = 0;
+    for (i = 0; i < NUMCARDS; ++i)
+    {
+        if (p->cards[i])
+        {
+            mask |= 1 << i;
+        }
+    }
+    v[n++] = mask;
+    v[n++] = p->backpack ? 1 : 0;
+    for (i = 0; i < NUMPOWERS; ++i) v[n++] = p->powers[i];
+    v[n++] = p->cheats;
+    v[n++] = p->refire;
+    v[n++] = p->killcount;
+    v[n++] = p->itemcount;
+    v[n++] = p->secretcount;
+    v[n++] = p->damagecount;
+    v[n++] = p->bonuscount;
+    v[n++] = p->extralight;
+    v[n++] = p->fixedcolormap;
+    v[n++] = p->colormap;
+    v[n++] = ThinkerIndex(p->attacker);
+    for (i = 0; i < 2; ++i)
+    {
+        pspdef_t *ps = &p->psprites[i];
+        v[n++] = StateIndex(ps->state);
+        v[n++] = ps->tics;
+        v[n++] = ps->sx;
+        v[n++] = ps->sy;
+    }
+    v[n++] = p->attackdown;
+    v[n++] = p->usedown;
+    for (i = 0; i < MAXPLAYERS; ++i) v[n++] = p->frags[i];
+    v[n++] = p->didsecret ? 1 : 0;
+
+    if (n != PLAYER_FIELDS)
+    {
+        I_Error("oracle: player field count %d", n);
+    }
+    fprintf(out, ";p%d=", pn);
+    for (i = 0; i < n; ++i)
+    {
+        fprintf(out, i == 0 ? "%d" : ",%d", v[i]);
+    }
+}
+
+static void WriteTraceLine(int tic)
+{
+    FILE *out[2];
+    int nout = 0;
+    boolean verbose;
+    uint64_t ha = FNV_BASIS, hs = FNV_BASIS, hl = FNV_BASIS, hd = FNV_BASIS, hx = FNV_BASIS;
+    int acount = 0, xcount = 0;
+    int i, k;
+    int32_t f[MOBJ_FIELDS > SPECIAL_MAX ? MOBJ_FIELDS : SPECIAL_MAX];
+
+    if (trace_file != NULL) out[nout++] = trace_file;
+    if (verbose_file != NULL) out[nout++] = verbose_file;
+    verbose = verbose_file != NULL && tic >= verbose_from && tic <= verbose_to;
+
+    BuildThinkerIndex();
+
+    for (i = 0; i < thinker_count; ++i)
+    {
+        thinker_t *th = thinker_list[i];
+
+        if (th->function.acp1 == (actionf_p1) P_MobjThinker)
+        {
+            MobjFields((mobj_t *) th, f);
+            for (k = 0; k < MOBJ_FIELDS; ++k) Fnv(&ha, f[k]);
+            ++acount;
+        }
+        else
+        {
+            int n = SpecialFields(th, f);
+            for (k = 0; k < n; ++k) Fnv(&hx, f[k]);
+            ++xcount;
+        }
+    }
+    for (i = 0; i < numsectors; ++i)
+    {
+        sector_t *s = &sectors[i];
+        Fnv(&hs, s->floorheight);
+        Fnv(&hs, s->ceilingheight);
+        Fnv(&hs, s->floorpic);
+        Fnv(&hs, s->ceilingpic);
+        Fnv(&hs, s->lightlevel);
+        Fnv(&hs, s->special);
+        Fnv(&hs, s->tag);
+        Fnv(&hs, s->soundtraversed);
+        Fnv(&hs, ThinkerIndex(s->soundtarget));
+        Fnv(&hs, ThinkerIndex(s->specialdata));
+    }
+    for (i = 0; i < numlines; ++i)
+    {
+        line_t *l = &lines[i];
+        Fnv(&hl, l->flags & ~0x100);
+        Fnv(&hl, l->special);
+        Fnv(&hl, l->tag);
+    }
+    for (i = 0; i < numsides; ++i)
+    {
+        side_t *sd = &sides[i];
+        Fnv(&hd, sd->textureoffset);
+        Fnv(&hd, sd->rowoffset);
+        Fnv(&hd, sd->toptexture);
+        Fnv(&hd, sd->bottomtexture);
+        Fnv(&hd, sd->midtexture);
+    }
+
+    for (k = 0; k < nout; ++k)
+    {
+        FILE *o = out[k];
+
+        fprintf(o, "t=%d;gs=%d;r=%d;lt=%d;map=%d,%d,%d;tot=%d,%d,%d", tic, (int) gamestate,
+                prndindex, leveltime, gameepisode, gamemap, (int) gameskill, totalkills,
+                totalitems, totalsecret);
+        for (i = 0; i < MAXPLAYERS; ++i)
+        {
+            if (playeringame[i])
+            {
+                PrintPlayer(o, i);
+            }
+        }
+        fprintf(o, ";a=%d,%016llx;s=%016llx;l=%016llx;d=%016llx;x=%d,%016llx;m=%d\n", acount,
+                (unsigned long long) ha, (unsigned long long) hs, (unsigned long long) hl,
+                (unsigned long long) hd, xcount, (unsigned long long) hx, rndindex);
+    }
+
+    if (verbose)
+    {
+        for (i = 0; i < thinker_count; ++i)
+        {
+            thinker_t *th = thinker_list[i];
+
+            if (th->function.acp1 == (actionf_p1) P_MobjThinker)
+            {
+                MobjFields((mobj_t *) th, f);
+                fprintf(verbose_file, "  a%d=", i);
+                for (k = 0; k < MOBJ_FIELDS; ++k)
+                {
+                    fprintf(verbose_file, k == 0 ? "%d" : ",%d", f[k]);
+                }
+            }
+            else
+            {
+                int n = SpecialFields(th, f);
+                fprintf(verbose_file, "  x%d=", i);
+                for (k = 0; k < n; ++k)
+                {
+                    fprintf(verbose_file, k == 0 ? "%d" : ",%d", f[k]);
+                }
+            }
+            fputc('\n', verbose_file);
+        }
+    }
+}
+
+void Oracle_AfterTic(void)
+{
+    if (trace_file != NULL || verbose_file != NULL)
+    {
+        WriteTraceLine(trace_tic);
+    }
+    oracle_last_tic = trace_tic;
+    ++trace_tic;
+}
