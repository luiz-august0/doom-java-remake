+//
+// Test-oracle extensions for the doom-java project (see tools/oracle/FORMAT.md).
+//
+// Every feature is opt-in through a command-line flag:
+//   -trace <file>                   per-tic trace v1 (docs/contracts.md section 6)
+//   -traceverbose <file>            verbose trace; -tracefrom/-traceto <tic> restrict the detail
+//   -dumpframe <tic,tic,...> <dir>  raw 320x200 frame + scene sidecar after the display of tic N
+//   -dumpdefs <file>                definition tables after DEHACKED
+//
+
+#ifndef ORACLE_H
+#define ORACLE_H
+
+#include <stdio.h>
+
+// Called once after all DEHACKED patches are loaded and the demo is known.
+void Oracle_Init(const char *iwadpath, const char *demoarg);
+
+// Called right after every G_Ticker() call (d_net.c RunTic).
+void Oracle_AfterTic(void);
+
+// D_RunFrame hooks: before D_Display() and right after it (before the wipe/blit).
+void Oracle_BeforeDisplay(void);
+void Oracle_AfterDisplay(void);
+
+// Shared state, for the other oracle source files.
+extern const char *oracle_iwad;
+extern char oracle_demo[64];
+extern const char *oracle_version;
+extern int oracle_last_tic;
+
+void Oracle_WriteHeader(FILE *f, const char *magic);
+void Oracle_DumpDefs(const char *filename);
+void Oracle_DumpFrameInit(const char *list, const char *dir);
+
+// Palette index currently loaded by the status bar code.
+int ST_GetPaletteIndex(void);
+
+// All strings replaced through DEHACKED, sorted by original text.
+void DEH_DumpStrings(FILE *f);
+
+#endif
