+static const char *BaseName(const char *path)
+{
+    const char *p = strrchr(path, '/');
+    const char *q = strrchr(path, '\\');
+
+    if (q != NULL && (p == NULL || q > p))
+    {
+        p = q;
+    }
+    return p != NULL ? p + 1 : path;
+}
+
+static boolean EndsWith(const char *s, const char *suffix)
+{
+    size_t a = strlen(s);
+    size_t b = strlen(suffix);
+
+    return a >= b && strcmp(s + a - b, suffix) == 0;
+}
+
+// Opens a text output file; a name ending in .gz is compressed through gzip(1).
+static FILE *OpenOutput(const char *name, boolean *is_pipe)
+{
+    FILE *f;
+
+    *is_pipe = false;
+    if (EndsWith(name, ".gz"))
+    {
+        char cmd[2048];
+
+        if (strchr(name, '\'') != NULL)
+        {
+            I_Error("oracle: unsupported character in file name %s", name);
+        }
+        snprintf(cmd, sizeof(cmd), "gzip -n -c > '%s'", name);
+        f = popen(cmd, "w");
+        *is_pipe = true;
+    }
+    else
+    {
+        f = fopen(name, "w");
+    }
+    if (f == NULL)
+    {
+        I_Error("oracle: cannot open %s for writing", name);
+    }
+    return f;
+}
+
+static void CloseOutput(FILE *f, boolean is_pipe)
+{
+    if (f == NULL)
+    {
+        return;
+    }
+    if (is_pipe)
+    {
+        pclose(f);
+    }
+    else
+    {
+        fclose(f);
+    }
+}
+
+static void Oracle_Close(void)
+{
+    CloseOutput(trace_file, trace_pipe);
+    trace_file = NULL;
+    CloseOutput(verbose_file, verbose_pipe);
+    verbose_file = NULL;
+}
+
+void Oracle_WriteHeader(FILE *f, const char *magic)
+{
