+            oracle_version);
+}
+
+void Oracle_Init(const char *iwadpath, const char *demoarg)
+{
+    int p;
+    const char *name;
+    size_t len, i;
+
+    oracle_iwad = iwadpath != NULL ? BaseName(iwadpath) : "unknown";
+    switch (gameversion)
+    {
+        case exe_ultimate: oracle_version = "ultimate"; break;
+        case exe_final:    oracle_version = "final"; break;
+        case exe_final2:   oracle_version = "final2"; break;
+        default:           oracle_version = "1.9"; break;
+    }
+    if (demoarg != NULL)
+    {
+        name = BaseName(demoarg);
+        M_StringCopy(oracle_demo, name, sizeof(oracle_demo));
+        len = strlen(oracle_demo);
+        if (len > 4 && strcasecmp(oracle_demo + len - 4, ".lmp") == 0)
+        {
+            oracle_demo[len - 4] = '\0';
+        }
+        for (i = 0; oracle_demo[i] != '\0'; ++i)
+        {
+            if (oracle_demo[i] >= 'a' && oracle_demo[i] <= 'z')
+            {
+                oracle_demo[i] -= 'a' - 'A';
+            }
+        }
+    }
+
+    p = M_CheckParmWithArgs("-tracefrom", 1);
+    if (p)
+    {
+        verbose_from = atoi(myargv[p + 1]);
+    }
+    p = M_CheckParmWithArgs("-traceto", 1);
+    if (p)
+    {
+        verbose_to = atoi(myargv[p + 1]);
+    }
+    p = M_CheckParmWithArgs("-trace", 1);
+    if (p)
+    {
+        trace_file = OpenOutput(myargv[p + 1], &trace_pipe);
+        Oracle_WriteHeader(trace_file, "doom-trace v1");
+    }
+    p = M_CheckParmWithArgs("-traceverbose", 1);
+    if (p)
+    {
+        verbose_file = OpenOutput(myargv[p + 1], &verbose_pipe);
+        Oracle_WriteHeader(verbose_file, "doom-trace v1");
+    }
+    if (trace_file != NULL || verbose_file != NULL)
+    {
+        I_AtExit(Oracle_Close, true);
+    }
+
+    p = M_CheckParmWithArgs("-dumpframe", 2);
+    if (p)
+    {
+        Oracle_DumpFrameInit(myargv[p + 1], myargv[p + 2]);
+    }
+    p = M_CheckParmWithArgs("-dumpdefs", 1);
+    if (p)
