+// Prints a string in double quotes; \, " and non-printable bytes are escaped.
+static void PrintQuoted(FILE *f, const char *s)
+{
+    const unsigned char *p = (const unsigned char *) s;
+
+    fputc('"', f);
+    for (; *p != '\0'; ++p)
+    {
+        if (*p == '\\') fputs("\\\\", f);
+        else if (*p == '"') fputs("\\\"", f);
+        else if (*p == '\n') fputs("\\n", f);
+        else if (*p < 0x20 || *p >= 0x7f) fprintf(f, "\\x%02x", *p);
+        else fputc(*p, f);
+    }
+    fputc('"', f);
+}
+
+typedef struct
+{
+    const char *name;
+    cheatseq_t *seq;
+} cheat_entry_t;
+
+static void PrintCheat(FILE *f, const char *name, const cheatseq_t *c)
+{
+    size_t i;
+
+    fprintf(f, "cheat \"%s\" len=%d params=%d seq=", name, (int) c->sequence_len,
+            c->parameter_chars);
+    // the sequence is raw bytes (DEHACKED may write any byte); print as hex
+    for (i = 0; i < c->sequence_len; ++i)
+    {
+        fprintf(f, "%02x", (unsigned char) c->sequence[i]);
+    }
+    fputs(" text=\"", f);
+    for (i = 0; i < c->sequence_len; ++i)
+    {
+        unsigned char ch = (unsigned char) c->sequence[i];
+        if (ch == '\\' || ch == '"') fprintf(f, "\\%c", ch);
+        else if (ch < 0x20 || ch >= 0x7f) fprintf(f, "\\x%02x", ch);
+        else fputc(ch, f);
+    }
+    fputs("\"\n", f);
+}
