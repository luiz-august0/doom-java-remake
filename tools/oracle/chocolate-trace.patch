+static const char *ActionName(const state_t *s)
+{
+    size_t i;
+
+    if (s->action.acv == NULL)
+    {
+        return "NULL";
+    }
+    for (i = 0; i < sizeof(oracle_actions) / sizeof(oracle_actions[0]); ++i)
+    {
+        if ((void *) s->action.acv == oracle_actions[i].fn)
+        {
+            return oracle_actions[i].name;
+        }
+    }
+    return "UNKNOWN";
+}
